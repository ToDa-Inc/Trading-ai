SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
WORKER_SECRET=generate-a-random-secret

# OpenRouter — single API key for everything
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=Trading Coach Worker

# Multimodal model: video analysis + strategy merge
OPENROUTER_VIDEO_MODEL=google/gemini-3-flash-preview
OPENROUTER_CHAT_MODEL=google/gemini-3.1-flash-lite

# RAG embedding model (768-dim, must match web/.env.local)
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIMENSIONS=768

PORT=8000
